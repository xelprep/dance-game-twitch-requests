# Local Songs directory.
SONGS_DIR=C:\Games\DanceGame\Songs

# Enabling SECURE_MODE will clear all mod creds at startup!
SECURE_MODE=false

# Website/bot settings.
# NOTE: the bind address and the public/control ports are no longer read from
# this file. Configure them at runtime in the streamer control panel
# (Configuration → Network). Defaults: 0.0.0.0, port 3000 (public site) and
# port 3001 (control panel).
BOT_PREFIX=!
SEARCH_COMMAND=search
REQUEST_ID_COMMAND=requestid
MAX_REQUESTS_PER_USER=2
QUEUE_LIMIT=25
ALLOW_WEB_REQUESTS=false
CONTROL_PASSWORD=a-long-random-password
PUBLIC_URL=
STREAMER_VANITY_NAME=Streamer