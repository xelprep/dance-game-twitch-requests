# Local StepMania Songs directory.
SONGS_DIR=C:\Games\StepMania\Songs

# Website/bot settings.
PORT=3000
BOT_PREFIX=!
REQUEST_COMMAND=request
MAX_REQUESTS_PER_USER=2
QUEUE_LIMIT=25
ALLOW_WEB_REQUESTS=false
CONTROL_PASSWORD=a-long-random-password

