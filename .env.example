# Main Songs directory containing pack/song folders with .sm/.ssc files.
SONGS_DIR=

# Optional additional songs directory to scan. Leave empty to disable.
ADDITIONAL_SONGS_DIR=

# Optional root directory for generated StepMania course files.
# If unset or invalid, the app falls back to the data root's courses/ folder.
COURSES_DIR=

# Directory to store the songs database in. Leave empty for the default (the data root).
# A full file path can instead be set with DATABASE_PATH (takes precedence).
DB_DIR=

# Optional: relocate the entire data root (database, artwork cache, courses,
# control-panel TLS, and twitch.json). Leave empty for the default
# (~/.dance-game-requests in your home directory).
APP_DATA_DIR=

# Maximum threads for song scanning and artwork processing (-1 = use all available CPU cores)
SCANNER_THREADS=-1

# Enabling SECURE_MODE will clear all mod creds at startup!
SECURE_MODE=false

# Website/bot settings.
BOT_PREFIX=!
SEARCH_COMMAND=search
REQUEST_ID_COMMAND=requestid
MAX_REQUESTS_PER_USER=2
QUEUE_LIMIT=25
CONTROL_PASSWORD=a-long-random-password
PUBLIC_URL=
PUBLIC_HTTPS=true
STREAMER_VANITY_NAME=Streamer
