{
  "name": "dance-game-twitch-requests",
  "version": "1.0.0",
  "private": true,
  "description": "Dance Game song database with a Twitch chat request bot and web queue.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scan": "node scanner.js",
    "format": "prettier --write \"**/*.{js,css,html,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,css,html,md}\" --ignore-path .prettierignore"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "selfsigned": "^5.5.0",
    "tmi.js": "^1.8.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
