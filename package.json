{
  "name": "dance-game-twitch-requests",
  "version": "1.0.0",
  "private": true,
  "description": "Dance game song database with a Twitch chat request bot and web queue.",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "setup": "node setupTui.mjs",
    "scan": "node scanner.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1",
    "test:watch": "NODE_ENV=test node --test --watch --test-concurrency=1",
    "format": "prettier --write \"**/*.{js,cjs,mjs,css,html,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,css,html,md}\" --ignore-path .prettierignore"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "inquirer-file-selector": "^2.0.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5",
    "tmi.js": "^1.8.5",
    "ws": "^8.21.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
